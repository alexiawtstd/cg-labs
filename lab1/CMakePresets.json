			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "mingw-debug",
			"inherits": "debug",
			"generator": "MinGW Makefiles"
		},
		{
			"name": "mingw-release",
			"inherits": "release",
			"generator": "MinGW Makefiles"
		}
	]
}
