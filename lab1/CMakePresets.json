			"binaryDir": "build-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"Vulkan_INCLUDE_DIR": "C:/labsCG/Include",
				"Vulkan_LIBRARY": "C:/labsCG/Lib/vulkan-1.lib",
				"Vulkan_GLSLC_EXECUTABLE": "C:/labsCG/Bin/glslc.exe",
				"Vulkan_GLSLANGVALIDATOR_EXECUTABLE": "C:/labsCG/Bin/glslangValidator.exe"
			}
		},
		{
			"name": "release",
			"inherits": "common",
			"binaryDir": "build-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "msvc-debug",
			"inherits": "debug",
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "msvc-release",
